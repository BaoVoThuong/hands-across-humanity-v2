---
import { nextPage, pageOf } from '../../lib/pages';

/* These were called donateUrl and governanceUrl and pointed at /what-we-do/
   and /mission/ — a donate name on a link that never took a donation, and a
   primary step that skipped straight past Mission to page three. About Us is
   the start of the reading order, so its primary step is simply the next page
   in it, and the second button offers the one page with something to act on. */
const next = nextPage('about-us');
const events = pageOf('events')!;

interface Props {
  kicker?: string;
  title?: string;
  lead?: string;
  nextUrl?: string;
  eventsUrl?: string;
}

const {
  kicker = "Stay connected to the work",
  title = "See how community support takes shape.",
  lead = "Explore real activities, meet the people involved, and learn how practical support reaches communities.",
  nextUrl = next.href,
  eventsUrl = events.href
} = Astro.props;
---

<section class="section closing-cta-section" id="next-steps">
  <div class="container-narrow closing-cta-content">
    <span class="closing-cta-kicker reveal" style="--i:1">{kicker}</span>
    <h2 class="closing-cta-title reveal" style="--i:2">{title}</h2>
    <p class="closing-cta-lead reveal" style="--i:3">{lead}</p>

    <div class="btn-row closing-cta-actions reveal" style="--i:4">
      <a class="btn btn--primary closing-cta-btn-primary" href={nextUrl} id="closing-next-btn">
        {next.cta}<span class="btn__arrow" aria-hidden="true">→</span>
      </a>
      <a class="btn btn--ghost closing-cta-btn-secondary" href={eventsUrl}>
        {events.cta}
      </a>
    </div>

    <div class="closing-cta-trust reveal" style="--i:5">
      <span>Real activities</span>
      <span>Local partners</span>
      <span>Shared responsibility</span>
    </div>
  </div>
</section>

<style>
  .closing-cta-section {
    padding-block: var(--transition-padding, clamp(2rem, 4vh, 3rem));
    background-color: var(--transition-warm);
    color: var(--slate-900);
    border-top: 1px solid var(--transition-border);
    border-bottom: 1px solid var(--transition-border);
    position: relative;
  }

  .closing-cta-content {
    text-align: center;
  }

  .closing-cta-kicker {
    display: inline-block;
    font-size: var(--fs-micro, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--primary);
    margin-bottom: var(--space-3, 0.75rem);
  }

  .closing-cta-title {
    margin-block: 0 var(--space-4, 1rem);
    color: var(--slate-900);
  }

  .closing-cta-lead {
    margin-inline: auto;
    max-width: 42rem;
    color: var(--slate-700);
    font-size: var(--fs-lead, 1.15rem);
    line-height: 1.6;
  }

  .closing-cta-actions {
    justify-content: center;
    margin-top: var(--space-7, 2rem);
    gap: var(--space-4, 1rem);
  }

  .closing-cta-btn-primary {
    font-size: 1.0625rem;
    min-height: 3.35rem;
    padding-inline: 2.25rem;
  }

  .closing-cta-btn-secondary {
    font-size: 1rem;
    min-height: 3.35rem;
    color: var(--slate-900);
    border-color: var(--slate-900);
  }
  .closing-cta-btn-secondary:hover {
    background: rgba(15, 23, 42, 0.08);
    color: var(--slate-900);
    border-color: var(--slate-900);
  }

  .closing-cta-trust {
    font-size: var(--fs-small, 0.875rem);
    color: var(--transition-ink-muted);
    margin-top: var(--space-6, 1.75rem);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  @media (max-width: 640px) {
    .closing-cta-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
